              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "cookie": [],
          "body": "{\"files\":[\"test1.csv\",\"test2.csv\",\"test3.csv\",\"test18.csv\",\"test4.csv\",\"test5.csv\",\"test6.csv\",\"test9.csv\",\"test15.csv\"]}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('answers 200', () => pm.response.to.have.status(200))",
              "",
              "pm.test('keeps the { files } envelope of the external API', () => {",
              "  const body = pm.response.json()",
              "  pm.expect(Object.keys(body)).to.eql(['files'])",
              "  pm.expect(body.files).to.be.an('array')",
              "  body.files.forEach((name) => pm.expect(name).to.be.a('string'))",
              "})"
            ]
          }
